# Application: mock and live are explicit modes; live errors never fall back to mock.
APP_MODE=mock
LOG_LEVEL=INFO
LOG_DIR=logs
PLANS_DB_PATH=data/user/travel-rag.sqlite3

# DeepSeek-compatible model API used by CrewAI agents.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
RESEARCH_MODEL=deepseek-v4-flash
PLANNER_MODEL=deepseek-v4-pro
REVIEWER_MODEL=deepseek-v4-pro
RESEARCH_MAX_TOKENS=8192
PLANNER_MAX_TOKENS=8192
REVIEWER_MAX_TOKENS=4096

# Tavily is owned by the Research Agent.
TAVILY_API_KEY=

# Local RAG. CUDA is mandatory in live mode for this project.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
EMBEDDING_DEVICE=cuda
RERANKER_DEVICE=cuda
MODEL_LOCAL_FILES_ONLY=true
CHROMA_DIR=data/index/chroma
RETRIEVAL_TOP_K=8
RERANK_TOP_N=4
LOCAL_CONFIDENCE_THRESHOLD=0.55

# Put model/cache files on the dedicated D-drive environment.
HF_HOME=D:/Anaconda_envs/pkgs/travel-rag/.cache/huggingface
TORCH_HOME=D:/Anaconda_envs/pkgs/travel-rag/.cache/torch
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
